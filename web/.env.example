# ===== Next.js (Web) =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Database =====
# Dev: local SQLite (zero-config, MVP)
DATABASE_URL="file:./dev.db?connection_limit=1"

# Prod: Neon Serverless PostgreSQL (free tier: 0.5GB, auto-scaling pooler)
# 1. Create account at https://neon.tech
# 2. Copy connection string, set as Vercel env var + GitHub Secret (NEON_DATABASE_URL)
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/gamerank?schema=public&connection_limit=1"

# ===== Cloudflare R2 (media storage) =====
# 1. Create R2 bucket at https://dash.cloudflare.com
# 2. Generate API token with R2 read/write perms
# 3. Set as Vercel env vars
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=gamerank-media
# R2_PUBLIC_URL=  # e.g. https://media.gamerank.pro

# ===== DeepSeek API (LLM content rewriting) =====
# 1. Get API key at https://platform.deepseek.com
# 2. Set as GitHub Secret (DEEPSEEK_API_KEY) for content-refresh workflow
# DEEPSEEK_API_KEY=

# ===== Site Search =====
# V1 uses DB LIKE fuzzy search (sufficient for 100 games)
# Migrate to MeiliSearch/Algolia when daily UV > 5000 or docs > 10K
# MEILI_URL=http://127.0.0.1:7700
# MEILI_API_KEY=

# ===== Analytics & Error Monitoring (optional) =====
# Plausible / Google Analytics ID
NEXT_PUBLIC_ANALYTICS_ID=
# Sentry DSN (frontend error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ===== Node runtime =====
NODE_ENV=development
TURBO_REMOTE_CACHE_SKIP_AUTH=1
