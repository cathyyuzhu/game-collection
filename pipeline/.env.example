# ===== LLM =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 如果需要兜底翻译（DeepL Pro）
DEEPL_AUTH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Database =====
# 与 web/.env 中的 DATABASE_URL 保持一致，两个服务共用一个 PostgreSQL
DATABASE_URL="postgresql://gamerank:gamerank@localhost:5432/gamerank?schema=public&pgbouncer=false"

# ===== Object Storage (Cloudflare R2) =====
# 所有游戏/攻略图片 & 视频 → 存 R2，R2 出站流量免费
R2_ACCOUNT_ID=c1xxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=gamerank-pro-media
R2_PUBLIC_DOMAIN=https://media.gamerank.pro   # 你的自定义 CDN 域名 或 .r2.dev

# ===== HTTP Crawler =====
# 国内 TapTap 爬虫建议挂国内 IP；App Store / RAWG 用境外代理池
HTTP_PROXY=http://user:pass@proxy-host:7890
HTTPS_PROXY=http://user:pass@proxy-host:7890
REQUEST_TIMEOUT=30
REQUEST_RETRY=3

# ===== Anti-ban =====
# 可选 Browserless / Playwright 远端 Chrome（JS 渲染的网站才用）
PLAYWRIGHT_WS_ENDPOINT=wss://browserless.example.com/chromium

# ===== Runtime =====
WORKER_CONCURRENCY=4
LLM_CONCURRENCY=10     # 注意 API 的 QPS 限额
LOG_LEVEL=INFO
