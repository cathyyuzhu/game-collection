# ============================================================
# Game Collection · Content Pipeline Environment Variables
# Copy this file to .env and fill in your API keys
# ============================================================

# ---- Database ----
# Match the DATABASE_URL in web/.env
DATABASE_URL="file:../web/prisma/dev.db"
# For production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_collection?schema=public"

# ---- LLM: DeepSeek (Primary) ----
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_V2=deepseek-chat          # For rewrite/translate (Step2-4)
DEEPSEEK_MODEL_V2_LITE=deepseek-chat     # For extract/quality (Step1,5) - actually V2-Lite is "deepseek-chat" too on newer plans, adjust if needed
# Alternative: if you have separate model names:
# DEEPSEEK_MODEL_V2_LITE=deepseek-reasoner

# ---- LLM: Fallback / Backup Model (Optional) ----
# Example: Qwen / Tongyi (backup if DeepSeek is down)
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# ---- Translation: DeepL (Optional, higher quality EN translation) ----
# Get from: https://www.deepl.com/pro-api
DEEPL_API_KEY=
# DEEPL_BASE_URL=https://api-free.deepl.com/v2  (free tier)
# DEEPL_BASE_URL=https://api.deepl.com/v2        (pro tier)

# ---- Third-Party Game Data API ----
# RAWG.io: free tier, 20k req/month for game metadata
# Get from: https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key-here
RAWG_BASE_URL=https://api.rawg.io/api

# ---- Crawler Configuration ----
# Crawler politeness: delay between requests (seconds)
CRAWLER_MIN_DELAY=2
CRAWLER_MAX_DELAY=5
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_RETRY_TIMES=3
CRAWLER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# ---- URL Deduplication: days before re-crawling the same URL ----
CRAWLER_DEDUP_DAYS=7

# ---- TapTap Configuration ----
# If you have an API key or specific headers, put them here
# TAPTAP_HEADERS=

# ---- Proxy Configuration (Optional, for anti-block) ----
# Format: http://user:pass@host:port  or  socks5://user:pass@host:port
# PROXY_URL=
# PROXY_POOL=  # comma-separated list for rotation

# ---- Pipeline Quality Settings ----
# Max similarity to source (0.0-1.0), pipeline will reject if exceeded
PIPELINE_MAX_SIMILARITY=0.30
# Max retries per step for LLM rewriting
PIPELINE_LLM_RETRIES=2
